# ---- companion server (docker compose reads this) ---------------------------------------
# Family password: full access. Required for anything reachable from outside your LAN.
COMPANION_PASSWORD=change-me
# Optional listen-only password for friends (spaces and case are ignored when typed).
COMPANION_GUEST_PASSWORD=
# teddycloud's web port as seen from INSIDE the companion container (uploads are encoded there).
TEDDYCLOUD_URL=http://teddycloud:80
# Port published on the host (put HTTPS in front of it).
COMPANION_PORT=8080
# Docker network the companion joins (use teddycloud's network to reach it by name).
COMPANION_NETWORK=companion_net
COMPANION_CONTAINER=companion

# ---- tc_sync.py (cron on the host; reads this file too) ----------------------------------
# Where this checkout / data lives (library.json, media/, state/, versions.json, apps/).
COMPANION_DIR=/home/user/teddycloud-companion
# teddycloud's data directory (config/, content/, library/, custom_img/, certs/) and container.
TEDDYCLOUD_DIR=/home/user/teddycloud
TEDDYCLOUD_CONTAINER=teddycloud
# teddycloud's web API as seen from the HOST.
TEDDYCLOUD_API=http://localhost:8095
# Public URL of the companion (fallback when the container IP cannot be resolved).
PUBLIC_URL=https://storie.example.com
# rsync target for the backup button / nightly backup ("sshalias:path"); empty = disabled.
BACKUP_TARGET=
